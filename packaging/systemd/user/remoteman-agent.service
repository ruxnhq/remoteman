[Unit]
Description=remoteman agent: this session's screen for paired devices
Documentation=https://github.com/xnixy/remoteman
# One in every graphical session, the login screen's included. It does nothing until the system
# service (remotemand) hands it a client.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/lib/remoteman/remoteman-agent --daemon
# If the agent goes (killed, crashed) while this computer is unlocked for a device, it is
# locked here, whatever the reason the agent stopped.
ExecStopPost=/usr/lib/remoteman/remoteman-agent --lock-if-left-unlocked
Restart=on-failure
RestartSec=2

[Install]
WantedBy=gnome-session.target
